   "source": [
    "# Program to generate a sequence using generator\n",
    "\n",
    "def numbers():\n",
    "    for i in range(1, 6):\n",
    "        yield i\n",
    "\n",
    "print(\"Number sequence:\")\n",
    "\n",
    "for number in numbers():\n",
    "    print(number)"
   ]
