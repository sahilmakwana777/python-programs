   "source": [
    "# Program to find sum of digits\n",
    "\n",
    "number = int(input(\"Enter a number: \"))\n",
    "\n",
    "sum = 0\n",
    "\n",
    "while number > 0:\n",
    "    digit = number % 10\n",
    "    sum = sum + digit\n",
    "    number = number // 10\n",
    "\n",
    "print(\"Sum of digits =\", sum)"
   ]
  },
